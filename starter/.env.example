# Persistent local Chroma database; no Docker or database service required.
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Local Chroma ONNX model; first embedding run downloads the model.
EMBEDDING_PROVIDER=chroma-local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# API keys are only needed if replacing the local embedder with a hosted provider.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
